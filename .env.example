# Public origin Claude connects to (must be reachable from the internet for Claude Desktop / claude.ai).
GATEWAY_PUBLIC_URL=https://mcp.example.com
# Hostname Caddy gets a certificate for.
GATEWAY_DOMAIN=mcp.example.com
# Generate with: docker compose run --rm gateway python -m gateway generate-key
GATEWAY_SECRET_KEY=

# Optional overrides (defaults shown)
# GATEWAY_SESSION_IDLE_TIMEOUT=900
# GATEWAY_MAX_SESSIONS_PER_USER=10
# GATEWAY_MAX_SESSIONS_PER_SERVER=25
# GATEWAY_AUDIT_RETENTION_DAYS=30
# GATEWAY_PURGE_HOUR=3
# TZ=Europe/Istanbul
# GATEWAY_ALLOWED_REDIRECT_URIS=["https://claude.ai/api/mcp/auth_callback","https://claude.com/api/mcp/auth_callback"]
